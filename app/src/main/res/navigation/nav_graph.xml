<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.lokalora.app.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_product_detail"
            app:destination="@id/nav_product_detail" />
        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/nav_search" />
    </fragment>

    <fragment
        android:id="@+id/nav_search"
        android:name="com.lokalora.app.ui.search.SearchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_search_to_product_detail"
            app:destination="@id/nav_product_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_cart"
        android:name="com.lokalora.app.ui.cart.CartFragment"
        android:label="@string/title_cart"
        tools:layout="@layout/fragment_cart">
        <action
            android:id="@+id/action_cart_to_checkout"
            app:destination="@id/nav_checkout" />
    </fragment>

    <fragment
        android:id="@+id/nav_orders"
        android:name="com.lokalora.app.ui.order.OrdersFragment"
        android:label="@string/title_orders"
        tools:layout="@layout/fragment_orders">
        <action
            android:id="@+id/action_orders_to_order_detail"
            app:destination="@id/nav_order_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.lokalora.app.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/nav_product_detail"
        android:name="com.lokalora.app.ui.product.ProductDetailFragment"
        android:label="Detail Produk"
        tools:layout="@layout/fragment_product_detail">
        <argument
            android:name="productId"
            app:argType="string" />
        <action
            android:id="@+id/action_detail_to_cart"
            app:destination="@id/nav_cart" />
    </fragment>

    <fragment
        android:id="@+id/nav_checkout"
        android:name="com.lokalora.app.ui.checkout.CheckoutFragment"
        android:label="Checkout"
        tools:layout="@layout/fragment_checkout">
        <action
            android:id="@+id/action_checkout_to_payment"
            app:destination="@id/nav_payment" />
    </fragment>

    <fragment
        android:id="@+id/nav_payment"
        android:name="com.lokalora.app.ui.payment.PaymentFragment"
        android:label="Pembayaran"
        tools:layout="@layout/fragment_payment">
        <argument
            android:name="orderId"
            app:argType="string" />
        <action
            android:id="@+id/action_payment_to_success"
            app:destination="@id/nav_payment_success"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/nav_payment_success"
        android:name="com.lokalora.app.ui.payment.PaymentSuccessFragment"
        android:label="Pembayaran Berhasil"
        tools:layout="@layout/fragment_payment_success">
        <argument
            android:name="orderId"
            app:argType="string" />
        <action
            android:id="@+id/action_success_to_order_detail"
            app:destination="@id/nav_order_detail"
            app:popUpTo="@id/nav_home"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/nav_order_detail"
        android:name="com.lokalora.app.ui.order.OrderDetailFragment"
        android:label="Detail Pesanan"
        tools:layout="@layout/fragment_order_detail">
        <argument
            android:name="orderId"
            app:argType="string" />
    </fragment>

</navigation>
